---
/**
 * InteractiveMap.astro
 * Interactive map of Argentina with clickable destinations
 * Premium visual experience for homepage
 */

interface Destination {
  id: string;
  name: string;
  slug: string;
  coordinates: { x: number; y: number }; // Percentage positions
  image: string;
  tagline: string;
  region: string;
}

const destinations: Destination[] = [
  {
    id: 'buenos-aires',
    name: 'Buenos Aires',
    slug: 'buenos-aires',
    coordinates: { x: 62, y: 68 },
    image: '/argentina/buenos-aires.jpg',
    tagline: 'La París de Sudamérica',
    region: 'Centro'
  },
  {
    id: 'mendoza',
    name: 'Mendoza',
    slug: 'mendoza',
    coordinates: { x: 35, y: 60 },
    image: '/argentina/mendoza.jpg',
    tagline: 'Capital del Vino',
    region: 'Cuyo'
  },
  {
    id: 'bariloche',
    name: 'Bariloche',
    slug: 'bariloche',
    coordinates: { x: 32, y: 80 },
    image: '/argentina/bariloche.jpg',
    tagline: 'La Suiza Argentina',
    region: 'Patagonia'
  },
  {
    id: 'el-calafate',
    name: 'El Calafate',
    slug: 'el-calafate',
    coordinates: { x: 28, y: 92 },
    image: '/argentina/el-calafate.jpg',
    tagline: 'Glaciares Eternos',
    region: 'Patagonia'
  },
  {
    id: 'el-chalten',
    name: 'El Chaltén',
    slug: 'el-chalten',
    coordinates: { x: 26, y: 90 },
    image: '/argentina/el-chalten.jpg',
    tagline: 'Capital del Trekking',
    region: 'Patagonia'
  },
  {
    id: 'ushuaia',
    name: 'Ushuaia',
    slug: 'ushuaia',
    coordinates: { x: 35, y: 98 },
    image: '/argentina/ushuaia.jpg',
    tagline: 'El Fin del Mundo',
    region: 'Patagonia'
  },
  {
    id: 'iguazu',
    name: 'Iguazú',
    slug: 'iguazu',
    coordinates: { x: 75, y: 38 },
    image: '/argentina/iguazu.jpg',
    tagline: 'Maravilla Natural',
    region: 'Litoral'
  },
  {
    id: 'salta',
    name: 'Salta',
    slug: 'salta',
    coordinates: { x: 42, y: 32 },
    image: '/argentina/salta.jpg',
    tagline: 'La Linda',
    region: 'Norte'
  },
  {
    id: 'cordoba',
    name: 'Córdoba',
    slug: 'cordoba',
    coordinates: { x: 48, y: 58 },
    image: '/argentina/cordoba.jpg',
    tagline: 'La Docta',
    region: 'Centro'
  }
];
---

<section class="interactive-map-section">
  <div class="map-header">
    <h2>🗺️ Descubre Argentina</h2>
    <p class="map-subtitle">Haz clic en cada destino para explorar tu próxima aventura</p>
  </div>
  
  <div class="map-container">
    <!-- Argentina SVG Map Silhouette -->
    <div class="argentina-map">
      <svg viewBox="0 0 100 140" class="map-svg">
        <!-- Simplified Argentina outline -->
        <path
          d="M 50,10 Q 55,12 58,15 L 65,25 Q 70,35 72,45 L 75,60 Q 76,70 75,80 L 70,95 Q 65,105 60,115 L 50,135 Q 45,138 40,137 L 35,130 Q 30,120 28,108 L 25,95 Q 22,80 23,65 L 25,50 Q 28,35 32,25 L 38,15 Q 42,10 50,10 Z"
          class="argentina-outline"
        />
      </svg>
      
      <!-- Destination Pins -->
      {destinations.map((dest) => (
        <a 
          href={`/destinos/${dest.slug}`}
          class="destination-pin"
          style={`left: ${dest.coordinates.x}%; top: ${dest.coordinates.y}%;`}
          data-destination={dest.id}
          data-name={dest.name}
          data-tagline={dest.tagline}
          data-image={dest.image}
          data-region={dest.region}
        >
          <div class="pin-marker">
            <svg width="24" height="32" viewBox="0 0 24 32">
              <path d="M12 0C5.4 0 0 5.4 0 12c0 8 12 20 12 20s12-12 12-20c0-6.6-5.4-12-12-12z" fill="currentColor"/>
              <circle cx="12" cy="12" r="4" fill="white"/>
            </svg>
          </div>
          <span class="pin-label">{dest.name}</span>
        </a>
      ))}
    </div>
    
    <!-- Preview Card (appears on hover) -->
    <div class="destination-preview" id="dest-preview">
      <div class="preview-image"></div>
      <div class="preview-content">
        <span class="preview-region"></span>
        <h3 class="preview-name"></h3>
        <p class="preview-tagline"></p>
        <button class="preview-btn">
          Ver Guía <i class="fas fa-arrow-right"></i>
        </button>
      </div>
    </div>
  </div>
  
  <!-- Legend -->
  <div class="map-legend">
    <div class="legend-item">
      <span class="legend-color norte"></span>
      <span>Norte</span>
    </div>
    <div class="legend-item">
      <span class="legend-color centro"></span>
      <span>Centro</span>
    </div>
    <div class="legend-item">
      <span class="legend-color cuyo"></span>
      <span>Cuyo</span>
    </div>
    <div class="legend-item">
      <span class="legend-color patagonia"></span>
      <span>Patagonia</span>
    </div>
    <div class="legend-item">
      <span class="legend-color litoral"></span>
      <span>Litoral</span>
    </div>
  </div>
</section>

<script>
  function initInteractiveMap() {
    const pins = document.querySelectorAll('.destination-pin');
    const preview = document.getElementById('dest-preview');
    
    if (!preview) return;
    
    const previewImage = preview.querySelector('.preview-image');
    const previewRegion = preview.querySelector('.preview-region');
    const previewName = preview.querySelector('.preview-name');
    const previewTagline = preview.querySelector('.preview-tagline');
    
    pins.forEach(pin => {
      pin.addEventListener('mouseenter', function(e) {
        const name = this.getAttribute('data-name');
        const tagline = this.getAttribute('data-tagline');
        const image = this.getAttribute('data-image');
        const region = this.getAttribute('data-region');
        
        // Update preview content
        previewName.textContent = name;
        previewTagline.textContent = tagline;
        previewRegion.textContent = region;
        previewImage.style.backgroundImage = `url('${image}')`;
        
        // Position preview near pin (responsive)
        const rect = this.getBoundingClientRect();
        const containerRect = this.closest('.map-container').getBoundingClientRect();
        
        const isMobile = window.innerWidth < 768;
        
        if (isMobile) {
          // On mobile, show at bottom
          preview.style.left = '50%';
          preview.style.top = 'auto';
          preview.style.bottom = '20px';
          preview.style.transform = 'translateX(-50%)';
        } else {
          // On desktop, show next to pin
          const leftPos = rect.left - containerRect.left + rect.width + 20;
          const topPos = rect.top - containerRect.top - 80;
          
          preview.style.left = `${leftPos}px`;
          preview.style.top = `${Math.max(20, topPos)}px`;
          preview.style.transform = 'none';
        }
        
        // Show preview
        preview.classList.add('visible');
        
        // Highlight pin
        this.classList.add('active');
      });
      
      pin.addEventListener('mouseleave', function() {
        preview.classList.remove('visible');
        this.classList.remove('active');
      });
    });
    
    // Close preview when clicking outside
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.destination-pin') && !e.target.closest('.destination-preview')) {
        preview.classList.remove('visible');
        pins.forEach(p => p.classList.remove('active'));
      }
    });
  }
  
  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInteractiveMap);
  } else {
    initInteractiveMap();
  }
  
  document.addEventListener('astro:page-load', initInteractiveMap);
</script>

<style>
  .interactive-map-section {
    max-width: 1200px;
    margin: 60px auto;
    padding: 40px 20px;
  }
  
  .map-header {
    text-align: center;
    margin-bottom: 40px;
  }
  
  .map-header h2 {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--title, #2D3748);
    margin-bottom: 10px;
  }
  
  .map-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary, #718096);
  }
  
  /* Map Container */
  .map-container {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    padding: 40px;
    background: linear-gradient(135deg, #F8F9FA 0%, #E9ECEF 100%);
    border-radius: 24px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    min-height: 600px;
  }
  
  @media (prefers-color-scheme: dark) {
    .map-container {
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    }
  }
  
  /* Argentina Map */
  .argentina-map {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 500px;
  }
  
  .map-svg {
    width: 100%;
    height: 100%;
    opacity: 0.15;
  }
  
  .argentina-outline {
    fill: var(--gold, #F4B942);
    stroke: var(--gold, #F4B942);
    stroke-width: 0.5;
  }
  
  /* Destination Pins */
  .destination-pin {
    position: absolute;
    transform: translate(-50%, -100%);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 10;
  }
  
  .destination-pin:hover,
  .destination-pin.active {
    z-index: 20;
    transform: translate(-50%, -100%) scale(1.2);
  }
  
  .pin-marker {
    color: #F4B942;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
    transition: color 0.3s ease;
  }
  
  .destination-pin:hover .pin-marker,
  .destination-pin.active .pin-marker {
    color: #d97706;
    animation: bounce 0.6s ease;
  }
  
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  
  .pin-label {
    display: block;
    margin-top: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--title, #2D3748);
    text-align: center;
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.95);
    padding: 2px 8px;
    border-radius: 8px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  @media (prefers-color-scheme: dark) {
    .pin-label {
      background: rgba(30, 41, 59, 0.95);
      color: #f1f5f9;
    }
  }
  
  .destination-pin:hover .pin-label,
  .destination-pin.active .pin-label {
    opacity: 1;
  }
  
  /* Preview Card */
  .destination-preview {
    position: absolute;
    width: 280px;
    background: white;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.9);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 100;
  }
  
  @media (prefers-color-scheme: dark) {
    .destination-preview {
      background: #1e293b;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }
  }
  
  .destination-preview.visible {
    opacity: 1;
    pointer-events: all;
    transform: scale(1);
  }
  
  .preview-image {
    width: 100%;
    height: 160px;
    background-size: cover;
    background-position: center;
  }
  
  .preview-content {
    padding: 20px;
  }
  
  .preview-region {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #F4B942;
    background: rgba(244, 185, 66, 0.1);
    padding: 4px 10px;
    border-radius: 12px;
    margin-bottom: 8px;
  }
  
  .preview-name {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--title, #2D3748);
    margin: 8px 0;
  }
  
  @media (prefers-color-scheme: dark) {
    .preview-name {
      color: #f1f5f9;
    }
  }
  
  .preview-tagline {
    font-size: 0.9rem;
    color: var(--text-secondary, #718096);
    margin-bottom: 15px;
  }
  
  .preview-btn {
    width: 100%;
    padding: 10px;
    background: linear-gradient(135deg, #F4B942, #d97706);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.2s ease;
  }
  
  .preview-btn:hover {
    transform: translateY(-2px);
  }
  
  .preview-btn:active {
    transform: translateY(0);
  }
  
  /* Legend */
  .map-legend {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  
  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-secondary, #718096);
  }
  
  .legend-color {
    width: 16px;
    height: 16px;
    border-radius: 4px;
  }
  
  .legend-color.norte { background: #EF4444; }
  .legend-color.centro { background: #3B82F6; }
  .legend-color.cuyo { background: #8B5CF6; }
  .legend-color.patagonia { background: #10B981; }
  .legend-color.litoral { background: #F59E0B; }
  
  /* Responsive */
  @media (max-width: 768px) {
    .map-container {
      padding: 20px;
      min-height: 500px;
    }
    
    .argentina-map {
      min-height: 450px;
    }
    
    .destination-preview {
      width: calc(100% - 40px);
      position: fixed !important;
      left: 50% !important;
      bottom: 20px !important;
      top: auto !important;
      transform: translateX(-50%) !important;
    }
    
    .destination-preview.visible {
      transform: translateX(-50%) scale(1) !important;
    }
    
    .pin-label {
      font-size: 0.7rem;
      padding: 2px 6px;
    }
  }
</style>
